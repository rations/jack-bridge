/.vscode
/.claude
/CLAUDE.md
CODE-REVIEW.md
# Locally-built and prebuilt binaries — not shipped via git
/contrib/bin/
# Common local artifacts
*.o
*.obj
*.swp
# Compiler dependency files (gcc -MMD). Scoped to the source directories on
# purpose: a bare *.d also matched the contrib/etc/logrotate.d directory, which
# silently kept the logrotate config out of git while it still shipped in the
# release tarball -- so anyone installing from a clone got no log rotation.
/src/*.d
/src/gfx/*.d
/src/platform/*.d
/src/bluez/*.d
/src/mxeq/*.d
/tools/*.d
/jack-graph/src/*.d
# Locally built jack-graph binary; the shipped copy lives in contrib/bin/
/jack-graph/jack-graph
# The offline layout audit is a developer tool, built from tools/uirender.cpp and never shipped.
/tools/uirender
*.log
*.tar.gz