#!/sbin/openrc-run
description="Bluetooth adapter configuration (Discoverable/Pairable)"

depend() {
	need bluetoothd
	after bluetoothd
}

start() {
	ebegin "Configuring Bluetooth adapter for jack-bridge"

	if [ ! -x /usr/local/lib/jack-bridge/bluetooth-enable.sh ]; then
		eend 1 "bluetooth-enable.sh not found at /usr/local/lib/jack-bridge/bluetooth-enable.sh"
		return 1
	fi

	/usr/local/lib/jack-bridge/bluetooth-enable.sh >/dev/null 2>&1
	eend $?
}

stop() {
	ebegin "Stopping Bluetooth adapter configuration (no-op)"
	eend 0
}