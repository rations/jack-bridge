#!/sbin/openrc-run

description="Event-driven JACK connection manager"

# Define the command and let OpenRC handle the backgrounding
command="/usr/local/bin/jack-connection-manager"
command_background="yes"
pidfile="/var/run/${RC_SVCNAME}.pid"
logfile="/var/log/jack-connection-manager.log"

# We determine the user dynamically in start_pre
command_user="" 

depend() {
    need jackd-rt
    after jack-bridge-ports
}

start_pre() {
    # Detect desktop user
    local login_user=$(logname 2>/dev/null) || \
    login_user=$(awk -F: '$3>=1000 && $3<65534 {print $1; exit}' /etc/passwd)
    
    if [ -z "$login_user" ]; then
        eerror "Cannot detect desktop user"
        return 1
    fi

    # Set the user for the command
    command_user="$login_user"
    
    # Setup logfile
    touch "$logfile"
    chown "$login_user:$login_user" "$logfile"

    # Wait for JACK to be ready (Max 30s)
    ebegin "Waiting for JACK server to be available for $login_user"
    local i=0
    while [ $i -lt 30 ]; do
        su - "$login_user" -c "jack_lsp >/dev/null 2>&1" && break
        sleep 1; i=$((i+1))
    done
    
    if [ $i -eq 30 ]; then
        eend 1 "JACK not detected after 30s"
        return 1
    fi
    eend 0
}

# We don't need a custom start() or stop() anymore! 
# OpenRC uses the variables defined above to do it correctly.
# We just need to tell it where to send the output:
output_log="$logfile"
error_log="$logfile"
