/* 50-jack-bridge.rules
 * Polkit authorization rules for jack-bridge service management
 * 
 * Allows users in 'audio' group to:
 * - Start/stop/restart jackd-rt service
 * - Modify JACK configuration via helper script
 */

/* Allow audio group to manage jackd-rt service */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        subject.isInGroup("audio")) {
        /* Check if command involves jackd-rt service */
        var cmd = action.lookup("command_line");
        if (cmd && (cmd.indexOf("jackd-rt") >= 0 || cmd.indexOf("jack-bridge-service-helper") >= 0)) {
            return polkit.Result.YES;
        }
    }
});
