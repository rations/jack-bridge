# /etc/udev/rules.d/90-jack-bridge-alsa.rules
# Persistent ALSA card naming for jack-bridge
# Ensures internal audio is always named "Internal" regardless of probe order

# Internal PCI audio devices (HDA/HDMI)
SUBSYSTEM=="sound", KERNEL=="card*", ATTR{id}=="*HDA*", ATTR{subsystem_card}=="HDA", ATTR{name}=="*", NAME="Internal"
SUBSYSTEM=="sound", KERNEL=="card*", ATTR{id}=="*HDMI*", ATTR{subsystem_card}=="HDMI", ATTR{name}=="*", NAME="Internal"
SUBSYSTEM=="sound", KERNEL=="card*", DRIVER=="snd_hda_intel", ATTR{name}=="*", NAME="Internal"

# USB audio devices
SUBSYSTEM=="sound", KERNEL=="card*", ATTR{id}=="*USB*", ATTR{name}=="*", NAME="USB"

# Fallback for any PCI sound card not caught above (likely internal)
SUBSYSTEM=="sound", KERNEL=="card*", SUBSYSTEMS=="pci", ATTR{name}=="*", NAME="Internal"

# Fallback for any USB sound card not caught above
SUBSYSTEM=="sound", KERNEL=="card*", SUBSYSTEMS=="usb", ATTR{name}=="*", NAME="USB"