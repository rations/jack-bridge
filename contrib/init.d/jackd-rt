#!/bin/sh
### BEGIN INIT INFO
# Provides:          jackd-rt
# Required-Start:    $local_fs $remote_fs
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start JACK (classic jackd) at boot with realtime tuning
# Description:       Starts jackd as a regular user (detected) using ALSA device auto-detection.
### END INIT INFO

# contrib/init.d/jackd-rt - SysV init script for jackd (classic) with auto-detection.
# Template is non-hardcoded; overrides may be placed in /etc/default/jackd-rt

. /lib/lsb/init-functions

# Load overrides if present
if [ -r /etc/default/jackd-rt ]; then
    . /etc/default/jackd-rt
fi

# Defaults (can be overridden by /etc/default/jackd-rt)
: ${JACKD_USER:=""}
: ${JACKD_DEVICE:=""}
: ${JACKD_SR:=48000}
: ${JACKD_PERIOD:=256}
: ${JACKD_NPERIODS:=3}
: ${JACKD_PRIORITY:=70}
: ${JACKD_MIDI:="seq"}
: ${JACKD_ARGS:=""}
: ${JACKD_DAEMON:=/usr/bin/jackd}
: ${DETECT_SCRIPT:=/usr/local/lib/jack-bridge/detect-alsa-device.sh}
: ${JACKD_LOG:=/var/log/jackd-rt.log}

# Run a command as $USERNAME, from a context that must not depend on dbus.
#
# This script starts at S02 — before dbus (S04) and elogind (S05). `su` runs
# /etc/pam.d/su, which @includes common-session, which loads pam_elogind.so;
# with no system bus yet that module blocks, and dbus cannot start until this
# script returns, so boot stalls for ~2 minutes until PAM gives up. That is a
# dependency cycle, not slowness.
#
# /etc/pam.d/runuser is the minimal stack (rootok, keyinit, limits, unix) with
# no elogind module, so runuser switches user without ever touching the bus.
# It ships in util-linux; the su fallback exists only for exotic systems and is
# bounded so it can never stall boot the way the bare su did.
#
# Later services in this stack (jack-bridge-ports at S07) run after dbus and
# elogind are up, where plain `su -` is safe.
as_user() {
    if [ -x /usr/sbin/runuser ]; then
        /usr/sbin/runuser -l "$USERNAME" -c "$*"
    elif command -v timeout >/dev/null 2>&1; then
        timeout 15 su - "$USERNAME" -c "$*"
    else
        su - "$USERNAME" -c "$*"
    fi
}

start() {
    log_daemon_msg "Starting JACK (jackd) with realtime settings" "jackd-rt"
    
    # Check if already running
    if [ -f /var/run/jackd-rt.pid ]; then
        pid=$(cat /var/run/jackd-rt.pid 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            log_progress_msg "already running"
            log_end_msg 0
            return 0
        fi
        # Stale pidfile
        rm -f /var/run/jackd-rt.pid 2>/dev/null || true
    fi

    # Wait for ALSA devices to appear
    WAIT_SECS=2
    waited=0

    while [ $waited -lt $WAIT_SECS ]; do
        if [ -d /dev/snd ] && command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null | grep -v -E 'Loopback|Loop Back' | sed -n '/card /p' >/dev/null 2>&1; then
            # log_daemon_msg above leaves the console line open for log_end_msg
            # to close, so a bare echo to stdout lands mid-line and renders as
            # "...settings: jackd-rtjackd-rt: ALSA devices ready after 0s".
            # log_progress_msg appends to the open line, which is the LSB-shaped
            # way to report this. It does not go to $JACKD_LOG either: that log
            # is jackd's own stdout, and the failure path below tails it.
            log_progress_msg "alsa ready (${waited}s)"
            break
        fi
        sleep 1
        waited=$((waited+1))
    done

    # Inline: detect user to run under (no eval, fixed /bin/sh for helpers)
    USERNAME=""
    if [ -n "$JACKD_USER" ]; then
        USERNAME="$JACKD_USER"
    fi
    if [ -z "$USERNAME" ]; then
        # first user with UID>=1000 and in audio group
        for user in $(cut -d: -f1 /etc/passwd); do
            uid=$(id -u "$user" 2>/dev/null || true)
            if [ -n "$uid" ] && [ "$uid" -ge 1000 ]; then
                groups=$(id -nG "$user" 2>/dev/null || true)
                if printf '%s\n' " $groups " | grep -q ' audio '; then
                    USERNAME="$user"; break
                fi
            fi
        done
    fi
    if [ -z "$USERNAME" ]; then
        # fallback to first UID>=1000 even if not in audio
        for user in $(cut -d: -f1 /etc/passwd); do
            uid=$(id -u "$user" 2>/dev/null || true)
            if [ -n "$uid" ] && [ "$uid" -ge 1000 ]; then
                USERNAME="$user"
                break
            fi
        done
    fi
    [ -z "$USERNAME" ] && USERNAME="root"

    # Inline: detect ALSA device
    DEVICE=""
    if [ -n "$JACKD_DEVICE" ]; then
        DEVICE="$JACKD_DEVICE"
    elif [ -x "$DETECT_SCRIPT" ]; then
        DEVICE_OUT="$(/bin/sh "$DETECT_SCRIPT" 2>/dev/null || true)"
        if [ -n "$DEVICE_OUT" ]; then
            DEVICE="$DEVICE_OUT"
        else
            log_warning_msg "jackd-rt: detector returned empty; using hw:0"
            DEVICE="hw:0"
        fi
    else
        DEVICE="hw:0"
    fi

    # Build jackd args with playback and capture from the same detected device
    # -P: Playback uses detected device (can be hw:CARD=PCH, hw:CARD=HDMI, etc)
    # -C: Capture uses the same detected device (provides baseline mic via system:capture)
    #     Additional capture sources (USB, etc) are spawned as alsa_in clients by jack-route-select
    if [ -n "$JACKD_MIDI" ] && [ "$JACKD_MIDI" != "none" ]; then
        ARGS="-R -P${JACKD_PRIORITY} -d alsa -P ${DEVICE} -C ${DEVICE} -r ${JACKD_SR} -p ${JACKD_PERIOD} -n ${JACKD_NPERIODS} -X ${JACKD_MIDI} ${JACKD_ARGS}"
    else
        ARGS="-R -P${JACKD_PRIORITY} -d alsa -P ${DEVICE} -C ${DEVICE} -r ${JACKD_SR} -p ${JACKD_PERIOD} -n ${JACKD_NPERIODS} ${JACKD_ARGS}"
    fi

    # Ensure user exists
    if ! id "$USERNAME" >/dev/null 2>&1; then
        log_failure_msg "User $USERNAME does not exist"
        return 1
    fi

    # Ensure jackd binary exists
    if [ ! -x "$JACKD_DAEMON" ]; then
        log_failure_msg "jackd not found at $JACKD_DAEMON"
        return 1
    fi

    # Prepare log file and permissions
    touch "$JACKD_LOG" 2>/dev/null || true
    chown "$USERNAME":"$USERNAME" "$JACKD_LOG" 2>/dev/null || true

    # Build command: switch to $USERNAME through a login shell so PAM limits
    # apply, then exec jackd with logging.
    #
    # runuser, not `su -l`, for the reason described at as_user() above: su's PAM
    # stack loads pam_elogind.so, which blocks until dbus (S04) exists, and dbus
    # cannot start until this script (S02) returns. --background hides the stall
    # from the console, but jackd itself does not start until dbus comes up, so
    # the server arrived a minute or two into boot and every health check here
    # timed out on a server that was not running yet.
    #
    # Realtime privileges survive the swap: /etc/pam.d/runuser carries
    # `session required pam_limits.so`, so the @audio rtprio/memlock grants in
    # /etc/security/limits.d/audio.conf still apply.
    #
    # Export JACK_NO_AUDIO_RESERVATION so jackd skips session bus reservation when run as a system service
    if [ -x /usr/sbin/runuser ]; then
        SWITCH_USER="/usr/sbin/runuser -l \"$USERNAME\" -s /bin/sh"
    else
        SWITCH_USER="su -l \"$USERNAME\" -s /bin/sh"
    fi
    CMD="exec $SWITCH_USER -c 'export JACK_NO_AUDIO_RESERVATION=1; exec ${JACKD_DAEMON} ${ARGS} >>\"$JACKD_LOG\" 2>&1'"

    # Start jackd as login user via start-stop-daemon (no --chuid; PID tracks exec chain)
    start-stop-daemon --start --background --make-pidfile --pidfile /var/run/jackd-rt.pid \
        --startas /bin/sh -- -c "$CMD" \
        || { log_failure_msg "Failed to start jackd"; log_end_msg 1; return 1; }

    # Health check: prefer jack_wait, fallback to pid check
    JACK_WAIT_TIMEOUT=3  # sufficient for cold boot on modern systems

    # Both the probe and the autoconnect helper must run as $USERNAME: jackd was
    # just started under `su -l "$USERNAME"`, so its socket lives in that user's
    # runtime directory. Run as root they can never reach the server — the probe
    # answered "Cannot connect to server socket" on every boot and took the
    # failure branch below, and jack-autoconnect was a silent no-op. as_user()
    # does the switch without the dbus-dependent PAM stack; see its comment.
    if command -v jack_wait >/dev/null 2>&1; then
        if as_user "jack_wait -w -t $JACK_WAIT_TIMEOUT" >/dev/null 2>&1; then
            # Autoconnect (if present) runs once at startup
            if [ -x /usr/local/lib/jack-bridge/jack-autoconnect ]; then
                as_user "/usr/local/lib/jack-bridge/jack-autoconnect" >/dev/null 2>&1 || true
            fi
        elif [ -s /var/run/jackd-rt.pid ] && kill -0 "$(cat /var/run/jackd-rt.pid 2>/dev/null)" >/dev/null 2>&1; then
            # The server process is alive, it just has not answered a client yet.
            # Every downstream service waits for JACK on its own (jack-bridge-ports
            # polls at S07, jack-connection-manager for up to 30s at S08), so a
            # slow start is not a boot failure. Warn and let them do the waiting
            # rather than reporting failure over a server that is coming up.
            log_warning_msg "jackd not ready within ${JACK_WAIT_TIMEOUT}s but the process is alive; continuing"
        else
            log_warning_msg "jackd did not become ready in ${JACK_WAIT_TIMEOUT}s; last 30 lines of $JACKD_LOG:"
            tail -n 30 "$JACKD_LOG" 2>/dev/null || true
            log_end_msg 1
            return 1
        fi

        # NOTE: jack-connection-manager is now started by separate init script
        # (contrib/init.d/jack-connection-manager) for cleaner service management
    else
        sleep 1
        if ! { [ -s /var/run/jackd-rt.pid ] && kill -0 "$(cat /var/run/jackd-rt.pid 2>/dev/null)" >/dev/null 2>&1; }; then
            log_warning_msg "jackd appears to have exited early; last 30 lines of $JACKD_LOG:"
            tail -n 30 "$JACKD_LOG" 2>/dev/null || true
            log_end_msg 1
            return 1
        fi
    fi

    log_end_msg 0
    return 0
}

stop() {
    log_daemon_msg "Stopping JACK (jackd)" "jackd-rt"
    
    # Check if actually running
    if [ ! -f /var/run/jackd-rt.pid ]; then
        log_progress_msg "not running"
        log_end_msg 0
        return 0
    fi
    
    pid=$(cat /var/run/jackd-rt.pid 2>/dev/null || true)
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        log_progress_msg "not running"
        rm -f /var/run/jackd-rt.pid 2>/dev/null || true
        log_end_msg 0
        return 0
    fi
    
    # Stop JACK with proper retry strategy. The connection manager is a separate
    # service (contrib/init.d/jack-connection-manager) and stops itself when the
    # JACK server goes away, via its jack_on_shutdown() callback.
    log_progress_msg "stopping jackd (pid $pid)"
    start-stop-daemon --stop --pidfile /var/run/jackd-rt.pid --retry=TERM/10/KILL/2 --oknodo
    STOP_STATUS=$?
    rm -f /var/run/jackd-rt.pid 2>/dev/null || true
    
    if [ $STOP_STATUS -eq 0 ]; then
        log_end_msg 0
        return 0
    else
        log_end_msg 1
        return 1
    fi
}

status() {
    if [ -f /var/run/jackd-rt.pid ]; then
        pid=$(cat /var/run/jackd-rt.pid 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1; then
            echo "jackd running (pid $pid)"
            return 0
        fi
    fi
    echo "jackd not running"
    return 1
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        stop
        sleep 1
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac

exit 0
