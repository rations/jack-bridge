#!/bin/sh
# jack-route-select - Runtime JACK routing helper for jack-bridge
# Routes the JACK graph to Internal, USB, HDMI, or Bluetooth.
#
# Internal, HDMI and Bluetooth are reached without restarting JACK: jackd stays
# on the internal card and HDMI/Bluetooth get alsa_out bridges. USB is different
# -- jackd is restarted ON the interface, because feeding an external interface
# through alsa_out costs it exactly the latency it exists to provide. See
# ensure_server_device().
# Reads user config ~/.config/jack-bridge/devices.conf (overrides) and system /etc/jack-bridge/devices.conf.
# Persists PREFERRED_OUTPUT (and BLUETOOTH_DEVICE if provided) to per-user config without root.

set -e
set -u

# Config precedence: user overrides system
USER_CONF="${HOME}/.config/jack-bridge/devices.conf"
SYS_CONF="/etc/jack-bridge/devices.conf"

mkdir -p "$(dirname "$USER_CONF")" 2>/dev/null || true

# Defaults
PREFERRED_OUTPUT="internal"
# Set by ensure_server_device when it actually moves jackd. route() reads it to
# know the graph it sampled before the switch no longer exists.
SERVER_RESTARTED=""
BLUETOOTH_DEVICE=""
# Bluetooth alsa_out buffering. NOTE: this is the buffer on the *BlueALSA A2DP
# side*, NOT JACK's buffer. alsa_out is a resampling bridge between two clock
# domains, so these are deliberately decoupled from jackd's -p/-n. A2DP is a
# bursty, high-latency transport; a small (jackd-sized) buffer underruns
# constantly (err=-32 in /tmp/jack-route-select-bluealsa.log → crackle → alsa_out
# dies → ports vanish). Large defaults absorb that jitter. A minimum is enforced
# at spawn time (see ensure_bt_out) so a stale devices.conf that pins these to
# jackd-sized values (e.g. 256x3) cannot reintroduce the underruns. Set LARGER
# values in ~/.config/jack-bridge/devices.conf if you want more headroom.
BT_PERIOD="1024"
BT_NPERIODS="8"
# Minimum BlueALSA-side buffer (frames = BT_PERIOD*BT_NPERIODS). Below this the
# A2DP stream underruns; ensure_bt_out bumps to 1024x8 if a config goes lower.
BT_MIN_BUFFER="4096"
# Target delay (frames) the alsa_out DLL keeps buffered. Empty = auto-derive from
# the actual buffer (buffer/4). alsa_out ABORTS if target_delay+max_diff exceeds
# the buffer, so any value here is clamped to stay safely under it at spawn time.
BT_TARGET_DELAY=""

# How many times spawn_bridge tries to start an alsa_out/alsa_in before giving
# up, and it doubles the pause between attempts starting at 1s — so 5 tries span
# about 15s of device warm-up. This exists because a USB interface listed in
# `aplay -l` can still refuse to open for the first several seconds after boot;
# see spawn_bridge. Raise it in ~/.config/jack-bridge/devices.conf if an
# interface takes longer than that to become ready.
BRIDGE_SPAWN_TRIES="5"

# Where jack-graph's JACK settings dialog persists the server settings, via
# pkexec jack-bridge-service-helper. Read for the periods count, which no JACK
# client API exposes.
JACKD_DEFAULTS="/etc/default/jackd-rt"

# Fallbacks used only when neither the running server nor $JACKD_DEFAULTS can be
# read (jackd down, or a hand-rolled server). Not a policy setting: whenever the
# user's values are discoverable they win outright.
BRIDGE_PERIOD_FALLBACK="256"
BRIDGE_NPERIODS_FALLBACK="3"

# Logging for diagnostics
LOGFILE="/tmp/jack-route-select.log"
log() {
  # timestamped append
  printf "%s: %s\n" "$(date --iso-8601=seconds)" "$*" >>"$LOGFILE"
}

load_conf() {
  [ -f "$SYS_CONF" ] && . "$SYS_CONF"
  [ -f "$USER_CONF" ] && . "$USER_CONF"
}
 
# Write per-user current_output.conf and ensure ~/.asoundrc includes it inside
# a managed block so non-JACK ALSA apps use the selected output.
write_user_output_conf() {
  out_pcm="$1" # e.g. plughw:0,0 or jackbridge_bluealsa:DEV=AA:BB:..,PROFILE=a2dp
  log "write_user_output_conf: writing user output fragment for pcm='$out_pcm'"
  out_dir="$(dirname "$USER_CONF")"
  mkdir -p "$out_dir" 2>/dev/null || true
  out_path="$out_dir/current_output.conf"
  if ! cat > "$out_path" <<EOF
# Managed user output fragment for jack-bridge
pcm.current_output {
    type plug
    slave.pcm "$out_pcm"
}
EOF
  then
    log "ERROR: failed to write $out_path"
    return 1
  fi

  # Ensure ~/.asoundrc contains an include for this fragment inside managed markers.
  # NOTE: 50-jack.conf is installed once and is never modified at runtime — its
  # playback_ports must stay pointed at system:playback_*, because pointing it at
  # a device-specific port breaks ALSA whenever that device is absent.
  ASOUND="$HOME/.asoundrc"
  TMP="$(mktemp "${HOME}/.asoundrc.jb.XXXXXX" 2>/dev/null || mktemp /tmp/.asoundrc.jb.XXXXXX)"
  in_path="$out_dir/current_input.conf"
  bluealsa_defs="$out_dir/bluealsa_defaults.conf"
  # Strip existing block between markers if present, then append our managed block.
  if [ -f "$ASOUND" ]; then
    awk '
      BEGIN { skip=0; n=0 }
      /^# BEGIN jack-bridge/ { skip=1; next }
      /^# END jack-bridge/   { skip=0; next }
      { if (!skip) lines[++n] = $0 }
      END {
        # Emit the users content up to its last non-blank line. Trimming the
        # trailing blanks matters: this block runs on every device switch and
        # re-adds a separator line each time, so without the trim ~/.asoundrc
        # accumulates one extra blank line per switch, without bound.
        last = 0
        for (i = 1; i <= n; i++) if (lines[i] ~ /[^ \t]/) last = i
        for (i = 1; i <= last; i++) print lines[i]
      }
    ' "$ASOUND" > "$TMP".part || cp -f "$ASOUND" "$TMP".part
  else
    : > "$TMP".part
  fi
  {
    cat "$TMP".part
    echo
    echo "# BEGIN jack-bridge"
    echo "# Managed by jack-bridge helper — include per-user current_input.conf, bluealsa defaults and current_output.conf"
    echo "# Note: Playback routing is managed system-wide via /usr/share/alsa/alsa.conf.d/50-jack.conf"
    echo "include \"$in_path\""
    echo "include \"$bluealsa_defs\""
    echo "include \"$out_path\""
    echo "# END jack-bridge"
  } > "$TMP"
  if mv "$TMP" "$ASOUND"; then
    rm -f "$TMP".part 2>/dev/null || true
    chmod 644 "$ASOUND" 2>/dev/null || true
    log "Updated $ASOUND to include $in_path, $bluealsa_defs and $out_path"
    return 0
  else
    log "ERROR: failed to install $ASOUND"
    return 1
  fi
}
 
# Write BlueALSA defaults so 'jackbridge_bluealsa' PCM can be used without inline parameters
# $1 = MAC (or 00:00:00:00:00:00 for most-recent), $2 = PROFILE (e.g., a2dp), $3 = SRV (e.g., org.bluealsa)
write_bluealsa_defaults() {
 mac="${1:-00:00:00:00:00:00}"
 prof="${2:-a2dp}"
 srv="${3:-org.bluealsa}"
 out_dir="$(dirname "$USER_CONF")"
 mkdir -p "$out_dir" 2>/dev/null || true
 defs_path="$out_dir/bluealsa_defaults.conf"
 if ! cat > "$defs_path" <<EOF
# Managed by jack-bridge — BlueALSA defaults for parameterless 'jackbridge_bluealsa' PCM
# These match the @args names in 20-jack-bridge-bluealsa.conf
defaults.jackbridge_bluealsa.DEV "$mac"
defaults.jackbridge_bluealsa.PROFILE "$prof"
defaults.jackbridge_bluealsa.SRV "$srv"
EOF
 then
   log "ERROR: failed to write $defs_path"
   return 1
 fi
 chmod 644 "$defs_path" 2>/dev/null || true
 log "Wrote BlueALSA defaults (DEV=$mac PROFILE=$prof SRV=$srv) to $defs_path"
}
 
save_user_kv() {
  # $1=KEY $2=VALUE
  key="$1"; val="$2"
  tmp="${USER_CONF}.tmp"
  touch "$USER_CONF" 2>/dev/null || true
  { grep -v -E "^${key}=" "$USER_CONF" 2>/dev/null || true; echo "${key}=${val}"; } > "$tmp"
  mv "$tmp" "$USER_CONF"
}

have() { command -v "$1" >/dev/null 2>&1; }

# Single source of truth for the sink ports this stack manages. Both awk passes
# below read it, so adding an output device means editing one list.
# usb_out is absent on purpose: a USB interface is no longer bridged. When USB
# is the selected output jackd runs on the interface itself, so its ports ARE
# system:playback_*.
JB_SINKS="system:playback_1 system:playback_2
hdmi_out:playback_1 hdmi_out:playback_2
bluealsa:playback_1 bluealsa:playback_2"

# Locate the first ALSA device whose description matches a pattern.
#   $1 = aplay (playback) or arecord (capture)
#   $2 = pattern to match, e.g. USB or HDMI
# Echoes "card device" (device defaults to 0), or nothing when there is no match.
find_card_device() {
  _tool="$1"; _pattern="$2"
  have "$_tool" || return 0
  _line="$("$_tool" -l 2>/dev/null | grep "$_pattern" | head -n 1)"
  [ -n "$_line" ] || return 0
  _card=$(echo "$_line" | sed -n 's/^card \([0-9]\+\):.*/\1/p')
  _dev=$(echo "$_line" | sed -n 's/.*device \([0-9]\+\):.*/\1/p')
  [ -n "$_card" ] || return 0
  echo "$_card ${_dev:-0}"
}

# Detect internal card number: the first card whose `aplay -l` section does not
# mention USB. Falls back to 0.
#
# src/mxeq.c:get_internal_card_number() implements exactly this rule in C. The
# two must agree — if they drift, the GUI shows one card's mixer while audio
# routes to another. Change both together.
#
# Single pass over the output, which matches the C version. The previous version looped over a fixed
# card range and delimited each section with `sed ... | head -n -1`; it returned
# the wrong card in three cases, all verified against the C version:
#   - a gap in card numbering (card 0 USB, card 2 internal -> answered 0)
#   - the matching card being last in the output, because the range then ran to
#     EOF and `head -n -1` ate the only line it had
#   - two-digit card numbers, since the loop only covered 0..9
get_internal_card_number() {
    have aplay || { echo 0; return; }
    aplay -l 2>/dev/null | awk '
        /^card [0-9]+:/ {
            # New card header: the previous candidate survived, so take it.
            # `exit` still runs END, hence the done flag — without it the
            # answer is printed twice.
            if (cur != "" && !dirty) { print cur; done = 1; exit }
            cur = substr($0, 6, index($0, ":") - 6)
            dirty = 0
        }
        cur != "" && tolower($0) ~ /usb/ { dirty = 1 }
        END {
            if (!done) {
                if (cur != "" && !dirty) print cur; else print 0
            }
        }
    '
}

# The stable ALSA card id ("U192k", "sofhdadsp") for a card NUMBER.
#
# Card ids are used everywhere a device is persisted, because card numbers move:
# plugging in the interface on this machine makes it card 0 and pushes the
# internal card to 1. JACKD_DEVICE survives reboots, so a numeric device would
# silently point jackd at whichever card happened to enumerate first.
card_id_for_number() {
  [ -r "/proc/asound/card$1/id" ] || return 0
  cat "/proc/asound/card$1/id" 2>/dev/null || true
}

# True when a card id belongs to a USB device. /proc/asound/<id>/usbid is created
# by the USB audio driver and by nothing else, which is exact -- unlike grepping
# `aplay -l` for the string "USB", which also matches a card that merely mentions
# it in its description.
is_usb_card_id() { [ -e "/proc/asound/$1/usbid" ]; }

# Card id of the first USB audio card; empty when there is none.
usb_card_id() {
  for _d in /proc/asound/card*/; do
    _n="${_d#/proc/asound/card}"; _n="${_n%/}"
    case "$_n" in ''|*[!0-9]*) continue ;; esac
    _id="$(card_id_for_number "$_n")"
    [ -n "$_id" ] || continue
    if is_usb_card_id "$_id"; then
      echo "$_id"
      return 0
    fi
  done
}

internal_card_id() { card_id_for_number "$(get_internal_card_number)"; }

# The card jackd is currently running on, as a card id. Empty when jackd is down.
# jackd-rt starts it as `-d alsa -P <device> -C <device>`, so -P carries it.
server_card_id() {
  have ps || return 0
  _dev=$(ps -o args= -C jackd 2>/dev/null | sed -n 's/.*-P[[:space:]]\{1,\}\([^ ]*\).*/\1/p' | tail -n 1)
  [ -n "$_dev" ] || return 0
  case "$_dev" in
    hw:CARD=*) _t="${_dev#hw:CARD=}"; echo "${_t%%,*}" ;;
    hw:*)      _t="${_dev#hw:}";      card_id_for_number "${_t%%,*}" ;;
    *)         : ;;
  esac
}

# Make sure jackd is running on card id $1, restarting it there if it is not.
#
# This is the heart of the USB restructure. An external interface is no longer
# fed through alsa_out: when USB is selected, jackd runs ON the interface and
# system:playback_* IS the interface. alsa_out structurally needs a buffer larger
# than jackd's period (see the derivation in spawn_bridge), so a bridged
# interface can never have the low latency it exists for.
#
# Returns 0 when jackd is already on the wanted card -- that comparison is also
# what stops the boot path from looping, since jackd-rt has by then already
# started the server from JACKD_DEVICE.
ensure_server_device() {
  _want="$1"
  if [ -z "$_want" ]; then
    log "ensure_server_device: no card id for this target; leaving jackd where it is"
    return 0
  fi

  # Second guard, for the boot restore: jack-bridge-ports sets this because the
  # server it would be restarting is the one that just started.
  if [ -n "${JB_NO_SERVER_RESTART:-}" ]; then
    log "ensure_server_device: JB_NO_SERVER_RESTART set; not moving jackd (wanted '$_want')"
    return 0
  fi

  _cur="$(server_card_id)"
  if [ "$_cur" = "$_want" ]; then
    log "jackd already on card '$_want'; no restart"
    return 0
  fi

  log "Moving jackd from card '${_cur:-none}' to '$_want'"
  _helper="/usr/local/lib/jack-bridge/jack-bridge-service-helper"
  if [ ! -x "$_helper" ]; then
    log "ERROR: $_helper is missing; cannot move the server"
    return 1
  fi
  # Root already (boot / service context): call it directly. pkexec needs an
  # authentication agent, which no init script has.
  if [ "$(id -u)" = "0" ]; then
    if ! "$_helper" set-device "hw:CARD=$_want" >>"$LOGFILE" 2>&1; then
      log "ERROR: set-device hw:CARD=$_want failed"
      return 1
    fi
  else
    if ! pkexec "$_helper" set-device "hw:CARD=$_want" >>"$LOGFILE" 2>&1; then
      log "ERROR: pkexec set-device hw:CARD=$_want failed"
      return 1
    fi
  fi

  if ! wait_for_port "system:playback_1"; then
    log "ERROR: jackd did not come back on card '$_want'"
    return 1
  fi
  SERVER_RESTARTED=1
  log "jackd is now on card '$_want'"
  return 0
}

# Frames per period the HDMI bridge runs at: whatever the user set as
# frames/period in jack-graph's JACK settings, nothing else. The running server
# is asked first so a value changed at runtime (jack_bufsize) is honoured too;
# $JACKD_DEFAULTS is the fallback for when jackd is not up yet, which is the
# case during the boot restore.
jack_period() {
  _p=""
  if have jack_bufsize; then
    _p=$(jack_bufsize 2>/dev/null | tr -dc '0-9')
  fi
  if [ -z "$_p" ] && [ -r "$JACKD_DEFAULTS" ]; then
    _p=$(sed -n 's/^[[:space:]]*JACKD_PERIOD=["'"'"']\{0,1\}\([0-9]\{1,\}\).*/\1/p' "$JACKD_DEFAULTS" | tail -n 1)
  fi
  [ -n "$_p" ] || _p="$BRIDGE_PERIOD_FALLBACK"
  echo "$_p"
}

# Periods per buffer for the HDMI bridge, same rule. JACK exposes no client
# API for the ALSA driver's period count, so this comes from the running jackd's
# own command line first and from $JACKD_DEFAULTS second. Reading the process
# matters when a user edits the file without restarting the server: the bridge
# has to match the server that is actually running, not the one that will run
# next boot.
jack_nperiods() {
  _n=""
  if have ps; then
    _n=$(ps -o args= -C jackd 2>/dev/null | sed -n 's/.*[[:space:]]-n[[:space:]]\{1,\}\([0-9]\{1,\}\).*/\1/p' | tail -n 1)
  fi
  if [ -z "$_n" ] && [ -r "$JACKD_DEFAULTS" ]; then
    _n=$(sed -n 's/^[[:space:]]*JACKD_NPERIODS=["'"'"']\{0,1\}\([0-9]\{1,\}\).*/\1/p' "$JACKD_DEFAULTS" | tail -n 1)
  fi
  [ -n "$_n" ] || _n="$BRIDGE_NPERIODS_FALLBACK"
  echo "$_n"
}

jack_rate() {
  if have jack_samplerate; then
    r=$(jack_samplerate 2>/dev/null | awk '/sample rate/ {print $3; exit}')
    if [ -n "$r" ]; then
      echo "$r"
      return
    fi
  fi
  # Fallback
  echo 48000
}

# Parse jack_lsp -c and collect sources connected to any known sink ports
collect_current_sources() {
  have jack_lsp || return
  jack_lsp -c 2>/dev/null | awk -v sinks="$JB_SINKS" '
    BEGIN { n=split(sinks, a, /[ \n]+/); for (i=1;i<=n;i++) sink[a[i]]=1 }
    /^[^ \t]/ { cur=$1; next }
    /^[ \t]/ {
      to=$1;
      if (to in sink) {
        if (!(cur in seen)) { print cur; seen[cur]=1; }
      }
    }
  '
}

jack_disconnect_all_sinks() {
  have jack_lsp || return
  have jack_disconnect || return
  # Disconnect all connections to our known sinks
  jack_lsp -c 2>/dev/null | awk -v sinks="$JB_SINKS" '
    BEGIN { n=split(sinks, a, /[ \n]+/); for (i=1;i<=n;i++) sink[a[i]]=1 }
    /^[^ \t]/ { cur=$1; next }
    /^[ \t]/ {
      to=$1;
      if (to in sink) {
        print cur, to
      }
    }
  ' | while read -r src dst; do
    jack_disconnect "$src" "$dst" 2>/dev/null || true
  done
}

wait_for_port() {
  port="$1"
  # Wait up to 5 seconds (50 * 0.1s)
  for i in $(seq 1 50); do
    if jack_lsp 2>/dev/null | grep -q "^$port"; then
      return 0
    fi
    sleep 0.1
  done
  log "Timeout waiting for port $port"
  return 1
}

# Like wait_for_port, but gives up the moment the bridge process is gone.
# alsa_out/alsa_in exit within a fraction of a second when the ALSA open fails,
# so polling a corpse for the full 5s only delays the retry below.
wait_for_port_or_exit() {
  _wpid="$1"; _wport="$2"
  for _i in $(seq 1 50); do
    if jack_lsp 2>/dev/null | grep -q "^$_wport"; then
      return 0
    fi
    if ! kill -0 "$_wpid" 2>/dev/null; then
      return 1
    fi
    sleep 0.1
  done
  log "Timeout waiting for port $_wport"
  return 1
}

# Spawn an alsa_out/alsa_in bridge and wait for its JACK port, retrying with
# backoff until it appears.
#
# Being listed in `aplay -l` does not mean a device can be opened yet. On a cold
# boot the USB interface is listed by the time the boot restore runs (~19s in)
# but still answers snd_pcm_hw_params with ENXIO, so alsa_out logs
#   WARNING: channel count does not match (requested 2 got 4)
#   Unable to set hw params for playback: No such device or address
# and exits — while the identical command succeeds a minute later. With a single
# attempt that left USB silent after every reboot until the user opened the GUI,
# whereas HDMI, an always-ready HDA device, came back fine.
#
# Retrying is free when the device is ready: the first attempt returns as soon as
# the port registers. Only a device that is not ready pays the backoff.
#
# Buffering: the bridge runs at the frames/period the user chose in jack-graph,
# and at whatever period COUNT that value needs to stay startable. It cannot
# simply mirror jackd's -n, because alsa_out sizes its own working delay by
# subtracting jackd's period from the bridge's buffer (tools/alsa_out.c:771-777
# in the jackd2 source):
#
#     target_delay = (num_periods*period_size / 2) - jack_buffer_size/2
#
# where jack_buffer_size is jack_get_buffer_size(), i.e. jackd's FRAMES/PERIOD --
# not its total buffer. So the bridge's buffer has to exceed jackd's period, or
# the delay collapses toward zero and past it:
#
#     jackd 256, bridge 256x3 = 768  ->  target  256 frames   (works)
#     jackd 256, bridge 256x2 = 512  ->  target  128 frames   (USB distortion)
#     jackd 1024, bridge  768        ->  target -128 frames   (HDMI crackle)
#
# Hence the floor below: bridge buffer >= 3x jackd's period, which by that same
# formula leaves a target delay of exactly one full JACK cycle. Nothing is
# hardcoded -- the user's frames/period drives it, and the period count is only
# raised when their value would put the bridge under the floor.
#
# Bluetooth is deliberately exempt and keeps its own larger BT_* buffer: A2DP is
# a bursty transport in a wholly separate clock domain. See ensure_bt_out.
#
#   $1 alsa_out|alsa_in   $2 JACK client name   $3 ALSA device (hw:2 / hw:2,0)
#   $4 sample rate        $5 port to wait for   $6 log file for the bridge stderr
spawn_bridge() {
  _tool="$1"; _name="$2"; _hw="$3"; _rate="$4"; _port="$5"; _blog="$6"
  _period="$(jack_period)"
  _nperiods="$(jack_nperiods)"

  # One full JACK cycle of target delay; see the derivation above.
  _min_buffer=$(( _period * 3 ))
  _raised=""
  while [ $(( _period * _nperiods )) -lt "$_min_buffer" ]; do
    _nperiods=$(( _nperiods + 1 ))
    _raised="yes"
  done
  _buffer=$(( _period * _nperiods ))
  if [ -n "$_raised" ]; then
    log "$_name: raised bridge periods to $_nperiods (${_period}x${_nperiods}=${_buffer}) to clear the ${_min_buffer}-frame floor for a ${_period}-frame JACK period"
  fi

  # No -t/-m: alsa_out derives both from the buffer above, and its own default IS
  # the relationship this code sizes for. Passing them explicitly is how the
  # bridge previously ended up with a 128-frame delay on a 512-frame buffer.

  _try=1
  _delay=1
  while [ "$_try" -le "$BRIDGE_SPAWN_TRIES" ]; do
    log "Spawning $_name for $_hw (attempt $_try/$BRIDGE_SPAWN_TRIES, period=$_period nperiods=$_nperiods buffer=$_buffer min=$_min_buffer)"
    nohup "$_tool" -j "$_name" -d "$_hw" -r "$_rate" -p "$_period" -n "$_nperiods" \
      >>"$_blog" 2>&1 &
    _bpid=$!
    if wait_for_port_or_exit "$_bpid" "$_port"; then
      log "$_name ports spawned successfully"
      return 0
    fi
    # Clear a survivor that never registered its port, so the next attempt
    # cannot collide with a half-started client holding the device.
    pkill -f "$_tool -j $_name" 2>/dev/null || true
    log "$_name attempt $_try failed: $(tail -n 1 "$_blog" 2>/dev/null || true)"
    _try=$((_try + 1))
    if [ "$_try" -le "$BRIDGE_SPAWN_TRIES" ]; then
      sleep "$_delay"
      _delay=$((_delay * 2))
    fi
  done
  log "ERROR: $_name ports failed to spawn after $BRIDGE_SPAWN_TRIES attempts (check $_blog)"
  return 1
}

ensure_hdmi_out() {
  # RESPAWN hdmi_out with current HDMI device (handles device changes)
  # Kill existing hdmi_out process
  pkill -f "alsa_out -j hdmi_out" 2>/dev/null || true
  sleep 0.3
  
  # Detect current HDMI device
  found="$(find_card_device aplay HDMI)"
  hdmi_card="${found%% *}"
  hdmi_dev="${found#* }"
  
  # Fallback if no HDMI found (spawn with placeholder)
  if [ -z "$hdmi_card" ]; then
    log "No HDMI audio device detected; spawning hdmi_out with placeholder hw:98"
    hdmi_card="98"
    hdmi_dev="0"
  else
    log "HDMI audio device detected: card=$hdmi_card device=$hdmi_dev"
  fi
  
  hw_dev="hw:${hdmi_card}"
  if [ -n "$hdmi_dev" ] && [ "$hdmi_dev" != "0" ]; then
    hw_dev="hw:${hdmi_card},${hdmi_dev}"
  fi
  
  if have jack_samplerate; then
    rate=$(jack_rate)
  else
    rate=48000
  fi
  
  spawn_bridge alsa_out hdmi_out "$hw_dev" "$rate" \
    "hdmi_out:playback_1" /tmp/jack-route-select-hdmi-out.log
}

ensure_bt_out() {
  # ON-DEMAND spawning: Unlike HDMI (a hw:X,Y kernel node),
  # Bluetooth uses 'jackbridge_bluealsa' ALSA plugin that requires an ACTIVE connection.
  # This function spawns alsa_out ONLY when user selects Bluetooth output.
  mac_arg="$1"
  
  # Extract MAC if provided
  bt_mac=""
  if [ -n "${mac_arg}" ]; then
    if echo "$mac_arg" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'; then
      bt_mac="$mac_arg"
    fi
  fi
  
  # Write BlueALSA defaults FIRST (alsa_out will read these)
  if [ -n "$bt_mac" ]; then
    write_bluealsa_defaults "$bt_mac" "a2dp" "org.bluealsa"
    log "Updated BlueALSA defaults for MAC: $bt_mac"
  else
    write_bluealsa_defaults "00:00:00:00:00:00" "a2dp" "org.bluealsa"
    log "Updated BlueALSA defaults for most-recent device"
  fi
  
  # Kill any existing bluealsa alsa_out process (in case switching devices)
  pkill -f "alsa_out -j bluealsa" 2>/dev/null || true
  sleep 0.5  # Let process terminate
  
  # Enforce A2DP minimum buffer. A stale devices.conf may pin BT_PERIOD/BT_NPERIODS
  # to jackd-sized values (256x3=768) which underrun constantly; bump to 1024x8.
  bt_buffer=$(( BT_PERIOD * BT_NPERIODS ))
  if [ "$bt_buffer" -lt "${BT_MIN_BUFFER:-4096}" ]; then
    log "BT buffer ${bt_buffer} (${BT_PERIOD}x${BT_NPERIODS}) below A2DP minimum ${BT_MIN_BUFFER:-4096}; using 1024x8"
    BT_PERIOD=1024
    BT_NPERIODS=8
    bt_buffer=$(( BT_PERIOD * BT_NPERIODS ))
  fi

  # alsa_out ABORTS at startup if target_delay + max_diff > buffersize (default
  # max_diff == target_delay, so we need 2*target < buffer). Derive target = buffer/4
  # (=> total buffer/2) and clamp any explicit override. Pass -m explicitly so the
  # relationship is guaranteed regardless of alsa_out's internal default.
  if [ -n "${BT_TARGET_DELAY:-}" ]; then
    bt_target="$BT_TARGET_DELAY"
  else
    bt_target=$(( bt_buffer / 4 ))
  fi
  bt_max=$(( bt_buffer / 2 - 1 ))
  [ "$bt_target" -gt "$bt_max" ] && bt_target="$bt_max"
  [ "$bt_target" -lt 1 ] && bt_target=1

  # Spawn alsa_out reading from jackbridge_bluealsa PCM (uses defaults we just wrote)
  log "Spawning bluealsa alsa_out (period=$BT_PERIOD nperiods=$BT_NPERIODS buffer=$bt_buffer target_delay=$bt_target)"
  if have jack_samplerate; then
    rate=$(jack_rate)
  else
    rate=48000
  fi

  # -q 2 : good resample quality for the JACK<->A2DP clock bridge
  # -t/-m: target delay + max drift, both kept safely under the buffer (above)
  # Sample RATE must track JACK (-r); the buffer (-p/-n) is intentionally larger
  # than JACK's and device-side only. See BT_* defaults above.
  # Spawn in background - alsa_out will create bluealsa:playback_1/2 ports
  nohup alsa_out -j bluealsa -d jackbridge_bluealsa -r "$rate" -p "$BT_PERIOD" -n "$BT_NPERIODS" -q 2 -t "$bt_target" -m "$bt_target" \
    >>/tmp/jack-route-select-bluealsa.log 2>&1 &
  
  # Wait for ports to appear
  if wait_for_port "bluealsa:playback_1"; then
    log "bluealsa ports spawned successfully"
    return 0
  else
    log "ERROR: bluealsa ports failed to spawn (check /tmp/jack-route-select-bluealsa.log)"
    log "       Device may not be connected or BlueALSA daemon not running"
    return 1
  fi
}

route() {
  target="$1"
  arg2="${2:-}"
  load_conf
  # Remember selection per user
  save_user_kv "PREFERRED_OUTPUT" "$target"
  # For bluetooth remember device if provided
  if [ "$target" = "bluetooth" ] && [ -n "$arg2" ]; then
    if echo "$arg2" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'; then
      save_user_kv "BLUETOOTH_DEVICE" "jackbridge_bluealsa:DEV=${arg2},PROFILE=a2dp"
    else
      save_user_kv "BLUETOOTH_DEVICE" "$arg2"
    fi
  fi
  # Determine and write per-user ALSA output fragment so non-JACK apps have the chosen output
  out_pcm=""
  case "$target" in
    internal)
      # Detect the actual internal card (first non-USB card)
      _int_id="$(internal_card_id)"
      if [ -n "$_int_id" ]; then
        out_pcm="${INTERNAL_DEVICE:-hw:CARD=$_int_id}"
      else
        out_pcm="${INTERNAL_DEVICE:-hw:$(get_internal_card_number)}"
      fi
      ;;
    usb)
      # By card id, not plughw:N,M: this is jackd's own device now, and the card
      # NUMBER of a USB interface changes with what else is plugged in.
      _usb_id="$(usb_card_id)"
      if [ -n "$_usb_id" ]; then
        out_pcm="${USB_DEVICE:-hw:CARD=$_usb_id}"
      else
        out_pcm="${USB_DEVICE:-}"
      fi
      ;;
    hdmi)
      found="$(find_card_device aplay HDMI)"
      if [ -n "$found" ]; then
        out_pcm="plughw:${found% *},${found#* }"
      else
        out_pcm="${HDMI_DEVICE:-plughw:2,0}"
      fi
      ;;
    bluetooth)
      # Extract MAC address from arg2 or BLUETOOTH_DEVICE
      bt_mac=""
      if [ -n "${arg2}" ]; then
        if echo "$arg2" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'; then
          bt_mac="$arg2"
        fi
      fi
      # Write BlueALSA defaults so alsa_out can use short device name
      if [ -n "$bt_mac" ]; then
        write_bluealsa_defaults "$bt_mac" "a2dp" "org.bluealsa"
      else
        write_bluealsa_defaults "00:00:00:00:00:00" "a2dp" "org.bluealsa"
      fi
      # Use simple PCM name - parameters come from defaults
      out_pcm="jackbridge_bluealsa"
      ;;
    *)
      out_pcm="${PREFERRED_OUTPUT:-internal}"
      ;;
  esac
  if [ -n "$out_pcm" ]; then
    if write_user_output_conf "$out_pcm"; then
      log "Wrote per-user output fragment for '$out_pcm'"
    else
      log "Failed to write per-user output fragment for '$out_pcm'"
    fi
  fi

  # Determine sources currently feeding any sink
  sources="$(collect_current_sources || true)"

  case "$target" in
    internal)
      # Kill all on-demand clients when switching to internal
      pkill -f "alsa_out -j hdmi_out" 2>/dev/null || true
      pkill -f "alsa_out -j bluealsa" 2>/dev/null || true
      if ! ensure_server_device "$(internal_card_id)"; then
        log "ERROR: could not move jackd onto the internal card"
        return 1
      fi
      newpref="system:playback_"
      ;;
    usb)
      # No bridge. jackd moves ONTO the interface, so system:playback_* IS the
      # interface: no alsa_out, no resampler, no second clock domain, and the
      # user's frames/period is the real latency. See ensure_server_device.
      pkill -f "alsa_out -j hdmi_out" 2>/dev/null || true
      pkill -f "alsa_out -j bluealsa" 2>/dev/null || true

      _usb_id="$(usb_card_id)"
      if [ -z "$_usb_id" ]; then
        log "ERROR: no USB audio card present; cannot select USB"
        return 1
      fi
      if ! ensure_server_device "$_usb_id"; then
        log "ERROR: could not move jackd onto USB card '$_usb_id'"
        return 1
      fi
      newpref="system:playback_"
      ;;
    hdmi)
      # HDMI stays bridged: it is a second PCM on the card jackd already owns,
      # in the display engine's clock domain. Capture (internal mic) keeps
      # coming from jackd in duplex mode as system:capture_*.
      pkill -f "alsa_out -j bluealsa" 2>/dev/null || true
      if ! ensure_server_device "$(internal_card_id)"; then
        log "ERROR: could not move jackd onto the internal card for HDMI"
        return 1
      fi
      ensure_hdmi_out || log "WARNING: ensure_hdmi_out failed"
      newpref="hdmi_out:playback_"
      ;;
    bluetooth)
      pkill -f "alsa_out -j hdmi_out" 2>/dev/null || true
      if ! ensure_server_device "$(internal_card_id)"; then
        log "ERROR: could not move jackd onto the internal card for Bluetooth"
        return 1
      fi
      # Spawn on-demand Bluetooth client (kills existing first if any)
      ensure_bt_out "$arg2" || log "WARNING: ensure_bt_out failed"
      newpref="bluealsa:playback_"
      ;;
    *)
      echo "Usage: $0 {internal|usb|hdmi|bluetooth} [bluealsa-DEV or MAC]" >&2
      exit 1
      ;;
  esac

  # A server restart tore down every client that was feeding a sink, so the
  # source list sampled above names ports that no longer exist -- and so do the
  # connections this would otherwise disconnect. jack-connection-manager wires
  # clients to the new sink as they reconnect, the same path a fresh boot takes.
  if [ -n "$SERVER_RESTARTED" ]; then
    log "jackd was restarted for this switch; leaving reconnection to jack-connection-manager"
    exit 0
  fi

  # Disconnect from all known sinks
  jack_disconnect_all_sinks

  # Nothing was feeding a sink, so there is nothing to re-route. The new sink's
  # ports are up and the connection manager will wire up clients as they appear.
  if [ -z "$sources" ]; then
    exit 0
  fi

  # Reconnect all previous sources to new sink.
  # Ports are sorted by trailing channel number (out1 < out2 < out3) so the
  # positional mapping is correct regardless of JACK global registration order.
  clients=$(echo "$sources" | sed 's/:.*//' | sort -u)
  echo "$clients" | while IFS= read -r cname; do
    [ -z "$cname" ] && continue
    # Collect source ports for this client, sorted by channel number.
    client_srcs=$(echo "$sources" | while IFS= read -r s; do
      case "$s" in "${cname}:"*) echo "$s" ;; esac
    done | sort -V 2>/dev/null || echo "$sources" | while IFS= read -r s; do
      case "$s" in "${cname}:"*) echo "$s" ;; esac
    done | sort)
    # Get target sink input ports sorted by trailing channel number.
    # jack_lsp returns ports in JACK global registration order which is
    # not guaranteed to match channel numbers; sort -V gives 1,2,3,4 order.
    sink_ports=$(jack_lsp 2>/dev/null | grep "^${newpref}" | sort -V)
    idx=1
    echo "$client_srcs" | while IFS= read -r src; do
      [ -z "$src" ] && continue
      dst=$(echo "$sink_ports" | sed -n "${idx}p")
      [ -n "$dst" ] && jack_connect "$src" "$dst" 2>/dev/null || true
      idx=$((idx + 1))
    done
  done
}

main() {
  tgt="${1:-${PREFERRED_OUTPUT}}"
  arg2="${2:-}"
  if [ -z "${tgt}" ]; then
    echo "Usage: $0 {internal|usb|hdmi|bluetooth} [bluealsa-DEV or MAC]" >&2
    exit 1
  fi
  route "$tgt" "$arg2"
}

load_conf
main "$@"